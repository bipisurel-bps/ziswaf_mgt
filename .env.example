# =============================================================================
#  ZISWAF — environment template.  Copy to .env and fill in real values:
#      cp .env.example .env
#  NEVER commit .env. Secrets below are placeholders only.
# =============================================================================

# ---------- Application ----------
APP_NAME="ZISWAF"
APP_ENV=local                 # local | production
APP_KEY=                      # generate: php artisan key:generate (or `docker compose exec app php artisan key:generate`)
APP_DEBUG=true                # MUST be false in production
APP_URL=http://localhost:8080 # production: https://domainanda.org  (used for signed receipt URLs & Midtrans redirects)
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug               # production: warning

# ---------- Organisation (shown on receipts & public pages) ----------
ORG_NAME="Lembaga ZISWAF Contoh"
ORG_ADDRESS="Jl. Contoh No. 1, Jakarta"
ORG_PHONE=6281234567890

# ---------- Database (PostgreSQL 16) ----------
# Inside Docker the host is the compose service name "database".
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=ziswaf
DB_USERNAME=ziswaf
DB_PASSWORD=change-me-strong-password   # REQUIRED in production (docker-compose.prod.yml refuses to start without it)
DB_FORWARD_PORT=5432                    # dev only: host port bound to 127.0.0.1

# ---------- Session / cache / queue ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false   # production: true (HTTPS only)
CACHE_STORE=database
QUEUE_CONNECTION=database     # webhook receipts/notifications run on the queue worker
FILESYSTEM_DISK=local

# ---------- Midtrans Snap ----------
# Dashboard: https://dashboard.midtrans.com  -> Settings -> Access Keys
# Sandbox keys start with "SB-Mid-"; switch MIDTRANS_IS_PRODUCTION=true only with production keys.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx     # SECRET — server side only
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_HOURS=24
# Webhook (Payment Notification URL) to set in Midtrans dashboard:
#   ${APP_URL}/api/webhooks/midtrans

# ---------- Notifications (WhatsApp receipts) ----------
# NOTIFICATION_DRIVER: log (local/testing, writes to storage/logs) | fonnte (real WhatsApp)
NOTIFICATION_DRIVER=log
FONNTE_TOKEN=                 # SECRET — from https://md.fonnte.com (device token)
FONNTE_ENDPOINT=https://api.fonnte.com/send

# ---------- Zakat ----------
# Fallback gold price (Rp/gram) used until an admin sets one in Admin > Pengaturan Zakat.
GOLD_PRICE_PER_GRAM=1500000
MIN_DONATION=10000

# ---------- Seeder: default admin (CHANGE before seeding production) ----------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@ziswaf.test
ADMIN_PASSWORD=password

# ---------- Docker / VPS deployment (docker-compose.prod.yml) ----------
DOMAIN=domainanda.org         # root domain, no scheme. www.<domain> is also served.
NGINX_MODE=http               # http (bootstrap + certbot) -> https (after certificate is issued)
RUN_MIGRATIONS=false          # true = `php artisan migrate --force` on app container start
APP_PORT=8080                 # dev only: host port for nginx

# ---------- Mail (optional; not used by core flows) ----------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@domainanda.org"
MAIL_FROM_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
